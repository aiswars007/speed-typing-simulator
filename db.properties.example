# Speed Typing Online Database Configuration Template
# Copy this file to 'db.properties' and set your local database credentials.
# Note: 'db.properties' is ignored by Git to prevent leaking sensitive information.

db.url=jdbc:mysql://localhost:3306/speedtyping_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=your_db_username
db.password=your_db_password
